generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ApproachType {
  BRUTE_FORCE
  OPTIMAL
}

enum NoteFileType {
  IMAGE
  PDF
}

enum PurchaseType {
  BUNDLE
  CATEGORY
  PROBLEM
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum PrintedOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(USER)
  avatar       String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  dsaQualifiedAt       DateTime?
  certificateClaimedAt DateTime?

  purchases     Purchase[]
  printedOrders PrintedOrder[]
  bookmarks     Bookmark[]
  progress      UserProgress[]
  bookRatings   BookRating[]

  @@map("users")
}

model Category {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @db.Text
  isFree      Boolean    @default(false)
  price       Int        @default(19) // INR
  order       Int        @default(0)
  isPublished Boolean    @default(true)
  pdfUrl      String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  problems    Problem[]
  purchases   Purchase[]

  @@map("categories")
}

model Problem {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  difficulty   Difficulty        @default(MEDIUM)
  description  String            @db.Text
  inputFormat  String?           @db.Text
  outputFormat String?           @db.Text
  constraints  String?           @db.Text
  examples     Json?
  explanation  String?           @db.Text
  leetcodeUrl    String?
  youtubeUrl     String?
  apnaYoutubeUrl String?
  isFree         Boolean           @default(false)
  price        Int               @default(49) // INR
  order        Int               @default(0)
  isPublished  Boolean           @default(true)
  categoryId   String
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  codes        ProblemCode[]
  notes        HandwrittenNote[]
  purchases    Purchase[]
  bookmarks    Bookmark[]
  progress     UserProgress[]

  @@index([categoryId])
  @@map("problems")
}

model ProblemCode {
  id              String       @id @default(cuid())
  problemId       String
  problem         Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  approachType    ApproachType
  title           String
  explanation     String       @db.Text
  javaCode        String       @db.Text
  timeComplexity  String
  spaceComplexity String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([problemId, approachType])
  @@map("problem_codes")
}

model HandwrittenNote {
  id          String       @id @default(cuid())
  problemId   String
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String       @db.Text
  previewUrl  String?      @db.Text
  fileType    NoteFileType @default(IMAGE)
  pageCount   Int          @default(1)
  isProtected Boolean      @default(true)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([problemId])
  @@map("handwritten_notes")
}

model Purchase {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseType      PurchaseType
  categoryId        String?
  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  problemId         String?
  problem           Problem?              @relation(fields: [problemId], references: [id], onDelete: SetNull)
  amount            Int                   // INR
  currency          String                @default("INR")
  status            PurchaseStatus        @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  transactions      PaymentTransaction[]

  @@index([userId])
  @@index([purchaseType])
  @@index([status])
  @@map("purchases")
}

model PaymentTransaction {
  id                String   @id @default(cuid())
  purchaseId        String
  purchase          Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  razorpayPaymentId String
  amount            Int
  status            String
  payload           Json?
  createdAt         DateTime @default(now())

  @@index([purchaseId])
  @@map("payment_transactions")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, problemId])
  @@index([userId])
  @@map("bookmarks")
}

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(IN_PROGRESS)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@unique([userId, problemId])
  @@index([userId])
  @@map("user_progress")
}

model BundleConfig {
  id            String   @id @default("default")
  title         String   @default("Complete Striver's A to Z DSA Sheet – Handwritten PDF")
  description   String   @default("Download the complete collection of handwritten DSA notes covering all 20 topics.")
  price         Int      @default(299)
  originalPrice Int      @default(999)
  topicPrice    Int      @default(19)
  pdfUrl        String?  @default("/notes/strivers-a2z-dsa-notes.pdf")
  previewImages Json?
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("bundle_config")
}

model PrintedOrder {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  postalCode        String
  country           String             @default("India")
  notes             String?            @db.Text
  language          String?

  productTitle      String             @default("Complete Printed DSA Notes – Striver's A to Z Sheet")
  quantity          Int                @default(1)
  unitPrice         Int                @default(1499)
  deliveryCharge    Int                @default(0)
  totalAmount       Int                @default(1499)
  currency          String             @default("INR")

  paymentStatus     PurchaseStatus     @default(PENDING)
  paymentMethod     String             @default("RAZORPAY")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  orderStatus       PrintedOrderStatus @default(PENDING)
  trackingNumber    String?
  carrier           String?

  requiresCertificate Boolean          @default(false)
  certificateStatus   String?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("printed_orders")
}

model PrintedProductConfig {
  id             String   @id @default("default")
  title          String   @default("Complete Printed Handwritten DSA Notes")
  description    String   @default("Get the complete collection of handwritten DSA notes in physical printed format delivered to your address.")
  price          Int      @default(1499)
  originalPrice  Int      @default(3999)
  deliveryCharge Int      @default(0)
  isFreeShipping Boolean  @default(true)
  isActive       Boolean  @default(true)
  previewImages  Json?
  updatedAt      DateTime @updatedAt

  @@map("printed_product_config")
}

model HomepageSampleImage {
  id          String   @id @default(cuid())
  slotIndex   Int      @unique // 1, 2, 3, 4
  title       String
  caption     String?
  imageUrl    String   @db.Text
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("homepage_sample_images")
}

model BookRating {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  language  String   // "C" | "C++" | "Java" | "Python"
  rating    Int      // 1 to 5
  review    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([language])
  @@map("book_ratings")
}
