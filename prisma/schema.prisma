generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum MembershipType {
  NORMAL
  PLUS
}

enum MembershipPlan {
  MONTHLY
  YEARLY
}

enum SubmissionStatus {
  ACCEPTED
  WRONG_ANSWER
  COMPILATION_ERROR
  RUNTIME_ERROR
  TIME_LIMIT_EXCEEDED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ApproachType {
  BRUTE_FORCE
  OPTIMAL
}

enum NoteFileType {
  IMAGE
  PDF
}

enum PurchaseType {
  BUNDLE
  CATEGORY
  PROBLEM
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum PrintedOrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model User {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         Role           @default(USER)
  avatar       String?
  googleId     String?        @unique
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  dsaQualifiedAt       DateTime?
  certificateClaimedAt DateTime?

  membershipType       MembershipType @default(NORMAL)
  membershipPlan       MembershipPlan?
  membershipStartedAt  DateTime?
  membershipExpiresAt  DateTime?

  purchases         Purchase[]
  printedOrders     PrintedOrder[]
  bookmarks         Bookmark[]
  progress          UserProgress[]
  bookRatings       BookRating[]
  certificateOrders CertificateOrder[]
  membershipOrders  MembershipOrder[]
  codeSubmissions   CodeSubmission[]
  currentStreak     Int            @default(0)
  longestStreak     Int            @default(0)
  lastStreakDate    String?
  dailyStreaks      UserDailyStreak[]
  dailyChallengeAttempts DailyChallengeAttempt[]

  @@map("users")
}

model Category {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  description String     @db.Text
  isFree      Boolean    @default(false)
  price       Int        @default(19) // INR
  order       Int        @default(0)
  isPublished Boolean    @default(true)
  pdfUrl      String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  problems    Problem[]
  purchases   Purchase[]

  @@map("categories")
}

model Problem {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  difficulty   Difficulty        @default(MEDIUM)
  description  String            @db.Text
  inputFormat  String?           @db.Text
  outputFormat String?           @db.Text
  constraints  String?           @db.Text
  examples     Json?
  explanation  String?           @db.Text
  leetcodeUrl    String?
  youtubeUrl     String?
  apnaYoutubeUrl String?
  isFree         Boolean           @default(false)
  price        Int               @default(49) // INR
  order        Int               @default(0)
  isPublished  Boolean           @default(true)
  categoryId   String
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  codes        ProblemCode[]
  notes        HandwrittenNote[]
  purchases    Purchase[]
  bookmarks    Bookmark[]
  progress     UserProgress[]
  testCases    TestCase[]
  submissions      CodeSubmission[]
  dailyChallenges  DailyChallenge[]
  userDailyStreaks UserDailyStreak[]

  @@index([categoryId])
  @@map("problems")
}

model ProblemCode {
  id              String       @id @default(cuid())
  problemId       String
  problem         Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  approachType    ApproachType
  title           String
  explanation     String       @db.Text
  javaCode        String       @db.Text
  timeComplexity  String
  spaceComplexity String
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([problemId, approachType])
  @@map("problem_codes")
}

model HandwrittenNote {
  id          String       @id @default(cuid())
  problemId   String
  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String       @db.Text
  previewUrl  String?      @db.Text
  fileType    NoteFileType @default(IMAGE)
  pageCount   Int          @default(1)
  isProtected Boolean      @default(true)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([problemId])
  @@map("handwritten_notes")
}

model Purchase {
  id                String                @id @default(cuid())
  userId            String
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseType      PurchaseType
  categoryId        String?
  category          Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  problemId         String?
  problem           Problem?              @relation(fields: [problemId], references: [id], onDelete: SetNull)
  amount            Int                   // INR
  currency          String                @default("INR")
  status            PurchaseStatus        @default(PENDING)
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  transactions      PaymentTransaction[]

  @@index([userId])
  @@index([purchaseType])
  @@index([status])
  @@map("purchases")
}

model PaymentTransaction {
  id                String        @id @default(cuid())
  purchaseId        String?
  purchase          Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  printedOrderId    String?
  printedOrder      PrintedOrder? @relation(fields: [printedOrderId], references: [id], onDelete: Cascade)
  razorpayPaymentId String
  amount            Int
  status            String
  payload           Json?
  createdAt         DateTime      @default(now())

  @@index([purchaseId])
  @@index([printedOrderId])
  @@map("payment_transactions")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, problemId])
  @@index([userId])
  @@map("bookmarks")
}

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId   String
  problem     Problem        @relation(fields: [problemId], references: [id], onDelete: Cascade)
  status      ProgressStatus @default(IN_PROGRESS)
  completedAt DateTime?
  updatedAt   DateTime       @updatedAt

  @@unique([userId, problemId])
  @@index([userId])
  @@map("user_progress")
}

model BundleConfig {
  id            String   @id @default("default")
  title         String   @default("Complete Striver's A to Z DSA Sheet – Handwritten PDF")
  description   String   @default("Download the complete collection of handwritten DSA notes covering all 20 topics.")
  price         Int      @default(299)
  originalPrice Int      @default(999)
  topicPrice    Int      @default(19)
  pdfUrl        String?  @default("/notes/strivers-a2z-dsa-notes.pdf")
  previewImages Json?
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("bundle_config")
}

model PrintedOrder {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  userId            String?
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String
  postalCode        String
  country           String             @default("India")
  notes             String?            @db.Text
  language          String?

  productTitle      String             @default("Complete Printed DSA Notes – Striver's A to Z Sheet")
  quantity          Int                @default(1)
  unitPrice         Int                @default(1499)
  deliveryCharge    Int                @default(0)
  totalAmount       Int                @default(1499)
  currency          String             @default("INR")

  paymentStatus     PurchaseStatus     @default(PENDING)
  paymentMethod     String             @default("RAZORPAY")
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  orderStatus       PrintedOrderStatus @default(PENDING)
  trackingNumber    String?
  carrier           String?

  requiresCertificate Boolean          @default(false)
  certificateStatus   String?

  items               Json?

  transactions        PaymentTransaction[]
  certificateOrder    CertificateOrder?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("printed_orders")
}

model PrintedProductConfig {
  id             String   @id @default("default")
  title          String   @default("Complete Printed Handwritten DSA Notes")
  description    String   @default("Get the complete collection of handwritten DSA notes in physical printed format delivered to your address.")
  price          Int      @default(1499)
  originalPrice  Int      @default(3999)
  deliveryCharge Int      @default(0)
  isFreeShipping Boolean  @default(true)
  isActive       Boolean  @default(true)
  previewImages  Json?
  updatedAt      DateTime @updatedAt

  @@map("printed_product_config")
}

model HomepageSampleImage {
  id          String   @id @default(cuid())
  slotIndex   Int      @unique // 1, 2, 3, 4
  title       String
  caption     String?
  imageUrl    String   @db.Text
  order       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@map("homepage_sample_images")
}

model BookRating {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  language  String   // "C" | "C++" | "Java" | "Python"
  rating    Int      // 1 to 5
  review    String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([language])
  @@map("book_ratings")
}

model CertificateOrder {
  id                 String        @id @default(cuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Database-level uniqueness constraint: prevents duplicate confirmed purchases for this user
  certificateUserKey String?       @unique

  printedOrderId     String?       @unique
  printedOrder       PrintedOrder? @relation(fields: [printedOrderId], references: [id], onDelete: SetNull)

  orderNumber        String
  customerName       String
  customerEmail      String
  status             String        @default("CONFIRMED") // CONFIRMED, CANCELLED
  deliveryStatus     String        @default("PENDING")   // PENDING, PRINTED, PACKED, SHIPPED, DELIVERED
  trackingNumber     String?
  carrier            String?

  isReplacement      Boolean       @default(false)
  replacementNote    String?       @db.Text
  recordedByAdmin    String?       // Email/name of admin who recorded replacement

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([deliveryStatus])
  @@map("certificate_orders")
}

model MembershipOrder {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan              MembershipPlan
  amount            Int             // in INR (79 or 299)
  currency          String          @default("INR")
  status            PurchaseStatus  @default(PENDING) // PENDING, COMPLETED, FAILED
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?         @unique
  razorpaySignature String?
  startsAt          DateTime?
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@map("membership_orders")
}

model TestCase {
  id             String   @id @default(cuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input          String   @db.Text
  expectedOutput String   @db.Text
  isSample       Boolean  @default(false)
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([problemId])
  @@index([problemId, isActive, order])
  @@map("test_cases")
}

model CodeSubmission {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId     String?
  problem       Problem?         @relation(fields: [problemId], references: [id], onDelete: SetNull)
  language      String           // java, cpp, python, javascript
  code          String           @db.Text
  status        SubmissionStatus
  executionTime Float?           // in seconds
  memoryUsage   Int?             // in KB
  passedTests   Int              @default(0)
  totalTests    Int              @default(0)
  errorOutput   String?          @db.Text
  createdAt     DateTime         @default(now())

  @@index([userId])
  @@index([problemId])
  @@map("code_submissions")
}

model ExecutionLock {
  id        String   @id @default(cuid())
  userId    String
  problemId String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, problemId])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("execution_locks")
}

model DailyChallenge {
  id        String   @id @default(cuid())
  date      String   @unique // "YYYY-MM-DD" in Asia/Kolkata timezone
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([date])
  @@index([problemId])
  @@map("daily_challenges")
}

model UserDailyStreak {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String   // "YYYY-MM-DD" in Asia/Kolkata timezone
  problemId   String
  problem     Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("user_daily_streaks")
}

model DailyChallengeAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String   // "YYYY-MM-DD" in Asia/Kolkata timezone
  runCount    Int      @default(0)
  submitCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
  @@map("daily_challenge_attempts")
}
