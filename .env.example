# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/beenext_db?schema=public"

# App & Authentication
NEXT_PUBLIC_APP_URL="http://localhost:3000"
JWT_SECRET="your-super-secure-jwt-secret-min-32-chars"
SESSION_COOKIE_NAME="beenext_token"

# Default Admin Credentials for DB Seed
ADMIN_NAME="BeeNext Administrator"
ADMIN_EMAIL="supportbeenext@gmail.com"
ADMIN_PASSWORD="your_secure_admin_password"

# Default Customer Credentials for DB Seed
CUSTOMER_NAME="Customer Name"
CUSTOMER_EMAIL="customer@example.com"
CUSTOMER_PASSWORD="your_secure_customer_password"

# Razorpay Payment Gateway (Get from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Storage / Cloudinary (Optional - file proxy & upload handled)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
